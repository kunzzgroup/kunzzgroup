<IfModule mod_headers.c>
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</IfModule>

RewriteEngine On

# React backend v2 pages (parallel to legacy PHP pages)
RewriteRule ^[A-Za-z0-9_-]+-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]

# -----------------------------
# 0. Redirect login.html to frontend login (respect subdirectory deploy)
# -----------------------------
RewriteCond %{DOCUMENT_ROOT}/kunzzgroup/frontend/login.php -f
RewriteRule ^login\.html$ /kunzzgroup/frontend/login [L,R=301]

RewriteRule ^login\.html$ /frontend/login [L,R=301]

# -----------------------------
# 1. Protect Logic & APIs (Most Important)
# -----------------------------
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]

# Specific API Files (Fixed check_permissions filename)
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# -----------------------------
# 2. Serve Existing Files/Directories
# -----------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -----------------------------
# 3. Pretty URLs (Hide .php)
# -----------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# -----------------------------
# 4. Directory Index
# -----------------------------
DirectoryIndex index.php index.html
