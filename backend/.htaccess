<IfModule mod_headers.c>
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</IfModule>

RewriteEngine On

# React migration route (parallel to legacy PHP pages)
RewriteRule ^kpi-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^cost-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^kpiedit-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^costedit-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^generatecode-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^add-employee-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^stocklistall-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^stockeditall-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^stockremark-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^stockproductname-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^stocksot-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^stockminimum-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^dishware_stock-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^price-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^supply-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^bgmusicupload-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^homepage1upload-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^aboutpage1upload-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^aboutpage4upload-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^joinpage1upload-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^joinpage2upload-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^joinpage3upload-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^corporate_blueprint-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^corporate_blueprint_edit-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^qna-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]
RewriteRule ^evaluation_form-v2/?$ ../Kunzz-Landing-Page/dist/index.html [L]

# -----------------------------
# 0. Redirect login.html to frontend login (respect subdirectory deploy)
# -----------------------------
RewriteCond %{DOCUMENT_ROOT}/kunzzgroup/frontend/login.php -f
RewriteRule ^login\.html$ /kunzzgroup/frontend/login [L,R=301]

RewriteRule ^login\.html$ /frontend/login [L,R=301]

# -----------------------------
# 1. Protect Logic & APIs (Most Important)
# -----------------------------
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]

# Specific API Files (Fixed check_permissions filename)
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# -----------------------------
# 2. Serve Existing Files/Directories
# -----------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -----------------------------
# 3. Pretty URLs (Hide .php)
# -----------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# -----------------------------
# 4. Directory Index
# -----------------------------
DirectoryIndex index.php index.html
