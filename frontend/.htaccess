RewriteEngine On

# -----------------------------
# 1. Protect Logic & APIs (Most Important)
# -----------------------------
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]

# Specific API Files
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# -----------------------------
# 2. Serve Existing Files/Directories Directly
# -----------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -----------------------------
# 3. Directory Index
# -----------------------------
DirectoryIndex index.php index.html
