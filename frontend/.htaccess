RewriteEngine On

# -----------------------------
# 1. Protect Logic & APIs (Most Important)
# -----------------------------
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]

# Specific API Files (Fixed check_permissions filename)
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# -----------------------------
# 1.5. Force remove .php extension from URL bar
# If user manually visits /frontend/page.php, 301 redirect to /frontend/page
# -----------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# -----------------------------
# 2. Serve Existing Files/Directories
# -----------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -----------------------------
# 3. Pretty URLs (Hide .php)
# -----------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# -----------------------------
# 4. Directory Index
# -----------------------------
DirectoryIndex index.php index.html
