RewriteEngine On

# -----------------------------
# 终极浏览器缓存杀手 (Ultimate Cache Buster)
# -----------------------------
FileETag None
<IfModule mod_headers.c>
    Header unset ETag
    Header always set Cache-Control "max-age=0, no-cache, no-store, must-revalidate, proxy-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
</IfModule>

# -----------------------------
# 1. Protect Logic & APIs (Most Important)
# -----------------------------
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]

# Specific API Files (Fixed check_permissions filename)
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# -----------------------------
# 2. Serve Existing Files/Directories
# -----------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# -----------------------------
# 3. Pretty URLs (Hide .php)
# -----------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# -----------------------------
# 4. Directory Index
# -----------------------------
DirectoryIndex index.php index.html
