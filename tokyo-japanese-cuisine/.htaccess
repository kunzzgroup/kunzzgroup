RewriteEngine On

# 1. 设置默认首页为 tokyo.html (Set default index page)
DirectoryIndex tokyo.html

# 2. 移除 .html 或 .php 后缀访问 (Remove .html or .php extension)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 3. 明确确保 /tokyo 访问能指向 tokyo.html
RewriteRule ^tokyo/?$ tokyo.html [L]

# 4. 菜单路径优化 (Menu path optimization)
# 允许访问 /menu/grand 或 /menu/sushi
RewriteRule ^menu/(grand|sushi)/?$ menu.php#$1 [NE,L,R]
RewriteRule ^menu/?$ menu.php [L]

