RewriteEngine On

# -----------------------------------------------------
# 1. Protect actual logic & APIs from rewriting
# -----------------------------------------------------
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# -----------------------------------------------------
# 2. Aggressively Hide /frontend/index.php and /frontend/
# If a user's browser actually visits the ugly URL, redirect it
# to the root equivalent. This physically changes the URL bar.
# -----------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend/index\.php\s [NC]
RewriteRule ^frontend/index\.php$ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend/index\s [NC]
RewriteRule ^frontend/index$ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend/([^\.\s]+)\.php\s [NC]
RewriteRule ^frontend/([^/]+)\.php$ /$1 [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend/(.*)\s [NC]
RewriteRule ^frontend/(.*)$ /$1 [R=301,L]

# -----------------------------------------------------
# 2.5. Hide /frontend_en/ and route /en/ to frontend_en
# -----------------------------------------------------

# If browser visits /frontend_en/index or /frontend_en/index.php -> redirect to /en/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend_en/index(\.php)?\s [NC]
RewriteRule ^frontend_en/index(\.php)?$ /en/ [R=301,L]

# If browser visits /frontend_en/page.php -> redirect to /en/page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend_en/([^\.\s]+)\.php\s [NC]
RewriteRule ^frontend_en/([^/]+)\.php$ /en/$1 [R=301,L]

# If browser visits /frontend_en/anything -> redirect to /en/anything
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend_en/(.*)\s [NC]
RewriteRule ^frontend_en/(.*)$ /en/$1 [R=301,L]

# Route /en/ to frontend_en/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/?$ frontend_en/index.php [L]

# Route /en/pagename to frontend_en/pagename.php (if exists)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/frontend_en/$1.php -f
RewriteRule ^en/(.+)$ frontend_en/$1.php [L]

# Route /en/pagename to frontend_en/pagename.html (if exists)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/frontend_en/$1.html -f
RewriteRule ^en/(.+)$ frontend_en/$1.html [L]

# -----------------------------------------------------
# 3. Pretty URLs for j1/j2/j3 directories
# -----------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(j1|j2|j3)/
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# -----------------------------------------------------
# 4. Transparently Serve From /frontend
# If none of the above matches, map to frontend (without changing URL)
# -----------------------------------------------------

# First, check if it maps to a .php file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{DOCUMENT_ROOT}/frontend/$1.php -f
RewriteRule ^(.*)$ frontend/$1.php [L]

# Then, check if it maps to an .html file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{DOCUMENT_ROOT}/frontend/$1.html -f
RewriteRule ^(.*)$ frontend/$1.html [L]

# Finally, fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ frontend/$1 [L]
