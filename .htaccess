RewriteEngine On

# 1. Protect Logic & APIs (Most Important)
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]

# Specific API Files (Fixed check_permissions filename)
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# 2. Add an explicit rule to keep frontend/ hidden if typed directly
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+frontend/([^\s]+) [NC]
RewriteRule ^frontend/(.*)$ /$1 [R=301,L]

# 3. Handle actual routing to the frontend folder
# If the request is not for a real file/folder at the root, map it to frontend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ frontend/$1 [L]
