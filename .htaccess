RewriteEngine On

# -----------------------------------------------------
# 1. Protect actual logic & APIs from rewriting
# -----------------------------------------------------
RewriteRule ^api/ - [L]
RewriteRule ^backend/ - [L]
RewriteRule ^(costapi|stockapi|kpiapi|check_permissions)\.php$ - [L]

# -----------------------------------------------------
# 2. Pretty URLs for j1/j2/j3 directories
# -----------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(j1|j2|j3)/
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
